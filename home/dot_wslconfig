# Settings apply across all Linux distros running on WSL 2
[wsl2]

# Upper limit for the WSL VM (Docker Desktop runs inside it). Sized so the
# dockur/windows test VM (test/windows, 6 GB) fits with room to spare.
memory=12GB

# Swap storage for the WSL VM
swap=8GB

# Virtual processors for the WSL VM
processors=8

# Expose AMD-V/VT-x inside WSL so containers get /dev/kvm (needed by dockur/windows)
nestedVirtualization=true
