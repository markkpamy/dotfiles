# Linux Docker host. Copy to .env (gitignored) and adjust.
COMPOSE_FILE=compose.yml:compose.linux.yml

# VM disk and the clean-install copy. Both must be outside the repo.
STORAGE_DIR=/srv/dotfiles-windows/storage
GOLDEN_DIR=/srv/dotfiles-windows/golden

# Dotfiles checkout mounted as Z: (relative to this folder).
REPO_DIR=../..

WIN_VERSION=11
RAM_SIZE=6G
CPU_CORES=4
DISK_SIZE=96G

# Windows account. Use your real username if templates depend on it.
WIN_USERNAME=Docker
WIN_PASSWORD=change-me

# 0.0.0.0 = whole LAN; 127.0.0.1 = this host only (use an SSH tunnel). The web viewer has no login.
BIND_ADDR=0.0.0.0
WEB_PORT=8006
RDP_PORT=3389
