# Windows host (Docker Desktop). Copy to .env (gitignored) and adjust.
COMPOSE_FILE=compose.yml;compose.windows.yml

# Dotfiles checkout mounted as Z: (relative to this folder).
REPO_DIR=../..

WIN_VERSION=11
RAM_SIZE=6G
CPU_CORES=4
DISK_SIZE=96G

# Windows account. Use your real username if templates depend on it.
WIN_USERNAME=Docker
WIN_PASSWORD=change-me

# 127.0.0.1 = this machine only. The web viewer has no login.
BIND_ADDR=127.0.0.1
WEB_PORT=8006
# This machine's own Remote Desktop already uses 3389.
RDP_PORT=3390
